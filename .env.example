# Copier ce fichier en `.env` puis adapter. Ne jamais commiter `.env`.
# Les variables sont validées au démarrage par src/lib/env.ts (Zod).

# --- Application -----------------------------------------------------------
# URL publique du site, sans barre oblique finale. Sert aux liens des e-mails.
APP_URL="http://localhost:3000"

# --- Base de données (docker compose : PostgreSQL sur le port hôte 5433) ----
DATABASE_URL="postgresql://agora:agora@localhost:5433/agora?schema=public"
# Facultatif : surcharge des valeurs du docker-compose.yml
# POSTGRES_USER="agora"
# POSTGRES_PASSWORD="agora"
# POSTGRES_DB="agora"
# POSTGRES_PORT="5433"

# --- Authentification (Better Auth) -----------------------------------------
# Secret de signature des sessions et des jetons, 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# --- E-mails -----------------------------------------------------------------
# "smtp" (Mailpit en dev, ou tout serveur SMTP) ou "resend".
MAIL_PROVIDER="smtp"
# Adresse d'expédition. Le nom affiché est celui du club (src/config/site.ts).
MAIL_FROM="ne-pas-repondre@agora.localhost"
# SMTP — valeurs par défaut : Mailpit (docker compose), interface sur http://localhost:8025
# 127.0.0.1 plutôt que localhost : nodemailer met plusieurs secondes à résoudre « localhost » sous Windows.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Resend — requis seulement si MAIL_PROVIDER="resend"
RESEND_API_KEY=""

# --- Contact et fichiers -----------------------------------------------------
# Destinataire du formulaire de contact tant que l'adresse du club n'est pas saisie
# dans Administration > Paramètres. Sans l'une ni l'autre, le formulaire ne s'affiche pas.
CONTACT_EMAIL="contact@agora.localhost"
# Dossier des images téléversées (couvertures). Hors dépôt ; à placer sur un volume persistant.
UPLOAD_DIR="uploads"

# --- Assistant IA « Le Compagnon des Lettres » -------------------------------
# Sans clé, l'application fonctionne et l'assistant affiche « Assistant non connecté ».
# Fournisseur : seul "principal" (SDK du fournisseur installé) est pris en charge pour l'instant.
LLM_PROVIDER="principal"
# Clé d'API du fournisseur (sa console d'administration). Secret : ne jamais la commiter.
LLM_API_KEY=""
# Identifiant du modèle chez le fournisseur. Obligatoire avec la clé : sans lui, l'assistant
# reste « non connecté ».
LLM_MODEL=""
# Questions permises par membre et par jour (jour de Dakar, remis à zéro à minuit). Défaut : 20.
ASSISTANT_DAILY_LIMIT="20"

# --- Tests de bout en bout ---------------------------------------------------
# API de Mailpit, lue par Playwright pour suivre les liens reçus par e-mail.
MAILPIT_URL="http://localhost:8025"
# Facultatif : base des tests Vitest qui tournent contre PostgreSQL (défaut : DATABASE_URL).
# TEST_DATABASE_URL="postgresql://agora:agora@localhost:5433/agora?schema=public"
# Facultatif, Playwright : PW_DEV=1 (serveur de dev au lieu du build), PW_WORKERS (défaut 1),
# PW_CHANNEL (défaut msedge ; chromium en intégration continue), PORT (défaut 3210).
# Facultatif, outils de contrôle : CHROME_PATH (navigateur de scripts/lighthouse.mjs),
# CAPTURE_EMAIL et CAPTURE_PASSWORD (compte de test local pour scripts/captures.mjs).
