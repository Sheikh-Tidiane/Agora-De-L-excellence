# Modèle du fichier d'environnement de PRODUCTION.
#
# Sur le serveur : copier en `.env.production` à la racine du dépôt, remplir, puis
#   chmod 600 .env.production
# Ce fichier n'est JAMAIS commité (.gitignore : .env*). Gardez-en une copie chiffrée hors du
# serveur (docs/SAUVEGARDE.md) : sans BETTER_AUTH_SECRET, toutes les sessions sont perdues.
#
# Format : NOM="valeur", une par ligne. Pas de `$`, d'accent grave ni de guillemet dans les
# valeurs (le fichier est aussi lu par le shell au moment du build).
# Générer un secret :  openssl rand -hex 32

# --- Domaine et HTTPS (Caddy) ----------------------------------------------------
# Domaine du site, sans https:// ni barre oblique. Le sous-domaine www y redirige.
SITE_DOMAIN="agora-exemple.com"
# Adresse e-mail donnée à Let's Encrypt (avis d'expiration). « internal » = certificat local
# (essai sur un poste seulement, jamais en production).
CADDY_TLS="responsable-technique@exemple.com"
# HSTS : 300 (5 minutes) au départ. Passer à 31536000 (un an) après deux semaines sans incident.
HSTS_MAX_AGE="300"

# --- Application -------------------------------------------------------------------
# URL publique : https:// + SITE_DOMAIN, sans barre oblique finale. Sert aux liens des e-mails.
APP_URL="https://agora-exemple.com"

# --- Base de données ---------------------------------------------------------------
# La DATABASE_URL est construite par docker-compose.prod.yml à partir de ces trois valeurs
# (hôte `postgres`, réseau interne). Mot de passe : lettres et chiffres seulement
# (openssl rand -hex 32), pour ne pas avoir à l'encoder dans l'URL.
POSTGRES_USER="agora"
POSTGRES_PASSWORD=""
POSTGRES_DB="agora"

# --- Authentification (Better Auth) ---------------------------------------------------
# 32 caractères minimum : openssl rand -hex 32. Ne plus jamais le changer après l'ouverture
# (le changer déconnecte tout le monde et invalide les liens d'activation envoyés).
BETTER_AUTH_SECRET=""

# --- E-mails ---------------------------------------------------------------------------
# "smtp" (fournisseur SMTP : Brevo, OVH Zimbra, etc.) ou "resend".
MAIL_PROVIDER="smtp"
# Adresse d'expédition, sur le domaine du club (SPF, DKIM et DMARC configurés : DEPLOIEMENT.md).
MAIL_FROM="ne-pas-repondre@agora-exemple.com"
SMTP_HOST=""
# 587 + SMTP_SECURE="false" (STARTTLS) ou 465 + SMTP_SECURE="true" (TLS direct).
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Requis seulement si MAIL_PROVIDER="resend"
RESEND_API_KEY=""

# --- Contact ---------------------------------------------------------------------------
# Destinataire du formulaire de contact tant que l'adresse du club n'est pas saisie dans
# Administration > Paramètres.
CONTACT_EMAIL="contact@agora-exemple.com"

# --- Fichiers téléversés ------------------------------------------------------------------
# Fixé à /app/uploads (volume Docker `uploads`) par docker-compose.prod.yml : ne pas changer.
UPLOAD_DIR="/app/uploads"

# --- Assistant « Le Compagnon des Lettres » (facultatif) ---------------------------------
# Sans clé, le site fonctionne et l'assistant affiche « Assistant non connecté ».
LLM_PROVIDER="principal"
LLM_API_KEY=""
LLM_MODEL=""
ASSISTANT_DAILY_LIMIT="20"
