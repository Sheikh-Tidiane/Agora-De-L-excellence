# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads et artefacts de test
/uploads
/test-results
/playwright-report
/.lighthouse

# client Prisma généré
/src/generated

# captures du contrôle visuel : conservées en local seulement
/docs/captures/

# Sauvegardes locales de la base (scripts/backup.sh)
/backups/

# Communication (Remotion) : dépendances et rendus
/communication/node_modules
/communication/out/

# Déploiement : état local du serveur (versions en service)
/.deploy/


# Médias lourds : jamais dans Git (rendus, vidéos, sons, plans de tournage)
*.mp4
*.mov
*.webm
*.mkv
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
/communication/assets/sons/
/communication/assets/plans/*
!/communication/assets/plans/.gitkeep
/communication/*.mp4

# Médias personnels déposés à la racine (photos et vidéos WhatsApp)
/Deos/

# Sauvegardes et exports de base : données personnelles, jamais dans Git
*.dump
*.sql.gz
*.age

# Export des contenus (scripts/contenus-export.ts) : données du club, jamais dans Git
/export-contenus/

# Claude Code : réglages personnels du poste (les réglages partagés .claude/settings.json et
# .claude/agents/ sont, eux, versionnés)
/.claude/settings.local.json
