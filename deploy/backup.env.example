# Réglages de scripts/backup-prod.sh. Sur le serveur : /etc/agora/backup.env (chmod 600).
# Aucun secret ici : la clé B2 est dans /etc/agora/rclone.conf, la clé age du serveur est PUBLIQUE.
BACKUP_DIR="/var/backups/agora"
KEEP_DAYS="14"
# Clé(s) publique(s) age (une par ligne) : celles des deux personnes qui gardent la clé privée.
AGE_RECIPIENTS_FILE="/etc/agora/age-recipients.txt"
# Destination rclone : <nom du remote dans rclone.conf>:<bucket>
RCLONE_REMOTE="b2:agora-sauvegardes"
RCLONE_CONFIG="/etc/agora/rclone.conf"
# Surveillance (healthchecks.io, offre gratuite) : un e-mail si la sauvegarde échoue OU n'arrive pas.
HEALTHCHECK_URL="https://hc-ping.com/remplacer-par-l-identifiant-du-controle"
