# Chaque nuit à 02:30 UTC (= heure de Dakar), avant les redémarrages automatiques de 04:30.
# Persistent=true : rattrapée au démarrage si le serveur était éteint à l'heure prévue.
[Unit]
Description=Sauvegarde nocturne de L'Agora de l'Excellence

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
