# Rappels « carte à régler » (notification + e-mail), une fois par jour. Sans doublon.
# Journal : journalctl -u agora-rappels-carte
[Unit]
Description=Rappels de carte de membre de L'Agora de l'Excellence
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agora
Group=agora
WorkingDirectory=/srv/agora
ExecStart=/usr/bin/bash /srv/agora/scripts/prod-compose.sh run --rm -T tools pnpm exec tsx scripts/rappels-carte.ts
TimeoutStartSec=15min
